{
  "name": "platform-aws",
  "private": true,
  "description": "AWS infrastructure (CDK, TypeScript) for the campus operations platform: ops-command-center and iot-telemetry-pipeline on ECS Fargate, RDS, CloudFront and AWS IoT Core.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "synth": "cdk synth --quiet",
    "synth:production": "cdk synth --quiet -c stage=production -c siteFile=config/site.example.json",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "aws-cdk-lib": "^2.274.0",
    "cdk-nag": "^3.0.2",
    "constructs": "^10.8.1"
  },
  "devDependencies": {
    "@aws-sdk/client-iot": "^3.1156.0",
    "@aws-sdk/client-secrets-manager": "^3.1156.0",
    "@eslint/js": "^10.0.1",
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "aws-cdk": "^2.1146.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "pg": "^8.23.1",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "esbuild": true,
    "fsevents": false
  }
}
